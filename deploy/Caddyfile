{
  # Ajuste email para Let's Encrypt se quiser HTTPS automático
  # email you@example.com
}

:80 {
  # Healthcheck simples
  respond /health 200

  # API em /nemesis/api → strip só /nemesis e repassa para backend com /api intacto
  handle /nemesis/api/* {
    uri strip_prefix /nemesis
    reverse_proxy backend:8000
  }

  # Redireciona acessos diretos para /login -> /nemesis/login
  @login path /login*
  redir @login /nemesis{uri}

  # Redireciona /nemesis (sem barra) para /nemesis/
  @noslash path /nemesis
  redir @noslash /nemesis/

  # Frontend estático em /nemesis
  handle_path /nemesis/* {
    root * /usr/share/caddy/nemesis
    try_files {path} /index.html
    file_server
  }

  # Fallback opcional
  respond "Not found" 404
}
